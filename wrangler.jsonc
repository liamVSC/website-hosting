{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website-hosting",
  "main": "src/index.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
